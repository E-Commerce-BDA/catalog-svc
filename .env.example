PORT=4020
DATABASE_URL=postgresql://ecom:ecom-dev-only@localhost:5433/ecom
JWT_SECRET=super-secret-jwt-key-dev-only-change-in-prod-32chars
REDIS_URL=redis://localhost:6379
INTERNAL_SERVICE_KEY=dev-internal-service-key-change-in-prod

# order.created consumer. Set KAFKA_CONSUMER_ENABLED=false to keep the API up
# without a consumer; stock reservations then stay `held` until the 900s sweep.
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_ENABLED=true

# Fixture catalogue (db/002-seed-catalog.sql, run with `pnpm db:seed`). Real data
# arrives through the admin CRUD routes and through `product.imported`; this flag
# exists only so a development box can load the demo products. The script refuses
# to run without it, and the service refuses to boot with it in production.
CATALOG_ALLOW_FIXTURE_SEED=false
